---
import SchoolIcon from "./icons/School.astro";
import ShieldIcon from "./icons/Shield.astro";

const EDUCATION = [
  {
    type: "Degree",
    icon: SchoolIcon,
    title: "Bachelor of Science in Computer Science",
    school: "Inter American University of Puerto Rico – Bayamón",
    date: "Aug 2020 – May 2024",
    description: "Focused on software development, databases, and modern programming practices.",
  },
  {
    type: "Certificate",
    icon: ShieldIcon,
    title: "Google Cybersecurity Professional Certificate",
    school: "Coursera · Google",
    date: "2024",
    description: "Experience with Linux, basic cybersecurity concepts, and risk/threat detection.",
  },
];
---

<div class="grid gap-5 md:grid-cols-2">
  {
    EDUCATION.map((edu, i) => (
      <article
        data-reveal
        style={`--reveal-delay:${i * 90}ms`}
        class="flex flex-col rounded-2xl border border-white/10 bg-white/[0.03] p-6 transition duration-300 hover:-translate-y-1 hover:border-violet-400/40 hover:bg-white/[0.05]"
      >
        <div class="flex items-center justify-between gap-3">
          <span class="grid size-11 place-items-center rounded-xl border border-violet-400/25 bg-violet-500/10 text-violet-300">
            <edu.icon class="size-6" />
          </span>
          <span class="rounded-full border border-white/10 bg-white/5 px-2.5 py-0.5 text-xs font-medium text-white/70">
            {edu.type}
          </span>
        </div>
        <h3 class="mt-4 text-lg font-semibold leading-snug text-white">{edu.title}</h3>
        <p class="mt-1 text-sm text-violet-200/90">{edu.school}</p>
        <p class="mt-0.5 text-sm text-white/50">{edu.date}</p>
        <p class="mt-3 text-[15px] leading-relaxed text-white/75">{edu.description}</p>
      </article>
    ))
  }
</div>
