---
export interface Props {
  title: string;
  company: string;
  highlights: string[];
  tags?: string[];
  date: string;
  current?: boolean;
}

import { getLang, useTranslations } from "../i18n/ui";

const { title, company, highlights, tags = [], date, current = false } = Astro.props;
const t = useTranslations(getLang(Astro.currentLocale));
---

<span
  aria-hidden="true"
  class:list={[
    "absolute -start-[7px] mt-6 grid size-3.5 place-items-center rounded-full border-2",
    current ? "border-violet-300 bg-violet-500" : "border-zinc-500 bg-zinc-800",
  ]}
>
  {current && <span class="absolute inline-flex size-full animate-ping rounded-full bg-violet-400 opacity-50" />}
</span>

<article
  class:list={[
    "rounded-2xl border bg-white/[0.03] p-4 transition sm:p-5 duration-300 hover:border-violet-400/40 hover:bg-white/[0.05] md:p-6",
    current ? "border-violet-400/30" : "border-white/10",
  ]}
>
  <div class="flex flex-wrap items-center gap-2">
    <time class="text-sm text-white/60">{date}</time>
    {current && (
      <span class="rounded-full border border-emerald-400/30 bg-emerald-400/10 px-2 py-0.5 text-[11px] font-semibold uppercase tracking-wide text-emerald-200">
        {t("experience.current")}
      </span>
    )}
  </div>
  <h3 class="mt-1.5 text-lg font-semibold text-violet-300 md:text-xl">{title}</h3>
  <p class="text-[15px] text-white/80">{company}</p>

  <ul class="mt-4 space-y-2 text-[15px] leading-relaxed text-white/75">
    {
      highlights.map((item) => (
        <li class="flex gap-x-3">
          <span aria-hidden="true" class="mt-[9px] size-1.5 shrink-0 rounded-full bg-violet-400/80" />
          <span class="text-pretty">{item}</span>
        </li>
      ))
    }
  </ul>

  {
    tags.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-1.5" aria-label={t("a11y.techAndSkills")}>
        {tags.map((tag) => (
          <li class="rounded-md border border-white/10 bg-white/5 px-2 py-0.5 text-xs text-white/70">{tag}</li>
        ))}
      </ul>
    )
  }
</article>
