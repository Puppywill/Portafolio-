---
import LinkedInIcon from "./icons/Linked.astro";
import GithubIcon from "./icons/Github.astro";
import MailIcon from "./icons/Mail.astro";
import { CONTACT } from "../data/contact";
import { getLang, useTranslations } from "../i18n/ui";

const t = useTranslations(getLang(Astro.currentLocale));

const year = new Date().getFullYear();

const socials = [
  { name: "LinkedIn", href: CONTACT.linkedin, icon: LinkedInIcon, external: true },
  { name: "GitHub", href: CONTACT.github, icon: GithubIcon, external: true },
  { name: "Email", href: `mailto:${CONTACT.email}`, icon: MailIcon, external: false },
];
---

<footer class="mt-auto px-4 pb-10">
  <div
    class="mx-auto flex max-w-[740px] flex-col items-center justify-between gap-4 border-t border-white/10 pt-8 text-center md:flex-row md:text-left"
  >
    <div>
      <p class="text-sm text-white/70">© {year} William A. Rosado Pérez</p>
      <p class="mt-1 text-xs text-white/55">{t("footer.builtWith")}</p>
    </div>

    <nav aria-label={t("a11y.socialLinks")} class="flex items-center gap-2">
      {
        socials.map((s) => (
          <a
            href={s.href}
            aria-label={s.name}
            title={s.name}
            {...(s.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
            class="grid size-10 place-items-center rounded-full border border-white/10 bg-white/5 text-white/70 transition hover:-translate-y-0.5 hover:border-violet-400/50 hover:text-white"
          >
            <s.icon class="size-[18px]" />
          </a>
        ))
      }
    </nav>
  </div>
</footer>
