---
import "/src/animacionborderhead/animacionborderhead.css";

const LINKS = [
  { label: "Home", target: "top", class: "hidden sm:inline-flex" },
  { label: "Experience", target: "experience" },
  { label: "Projects", target: "projects" },
  { label: "Skills", target: "skills" },
  { label: "Contact", target: "contact" },
];
---

<header
  id="site-header"
  class="sticky top-0 z-50 w-full transition-colors duration-300"
>
  <div class="mx-auto flex max-w-[1120px] items-center justify-center px-3 py-4 sm:px-4">
    <nav
      aria-label="Main"
      class="relative flex items-center gap-0.5 rounded-full border border-white/10 bg-black/40 p-1 shadow-lg shadow-black/20 backdrop-blur-2xl animate-border-animation sm:gap-1"
    >
      {
        LINKS.map((link) => (
          <a
            href={`/#${link.target}`}
            data-target={link.target}
            class:list={[
              "nav-link inline-flex rounded-full px-3 py-1.5 text-[13px] font-medium transition-colors duration-200 sm:px-4 sm:text-sm",
              link.class,
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style is:global>
  #site-header.scrolled {
    background: rgb(24 24 27 / 0.55);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
  }

  .nav-link {
    color: rgb(229 231 235 / 0.75);
  }

  .nav-link:hover {
    color: #fff;
  }

  .nav-link.active {
    color: #fff;
    background: rgb(139 92 246 / 0.22);
    box-shadow: inset 0 0 0 1px rgb(167 139 250 / 0.35);
  }
</style>

<script>
  const header = document.getElementById("site-header");
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>(".nav-link[data-target]"));
  const sections = links
    .map((link) => document.getElementById(link.dataset.target ?? ""))
    .filter((el): el is HTMLElement => el !== null);

  function setActive(id: string) {
    links.forEach((link) => {
      const isActive = link.dataset.target === id;
      link.classList.toggle("active", isActive);
      if (isActive) link.setAttribute("aria-current", "location");
      else link.removeAttribute("aria-current");
    });
  }

  let ticking = false;

  function update() {
    ticking = false;
    const y = window.scrollY;
    header?.classList.toggle("scrolled", y > 8);

    if (y < 150) return setActive("top");

    // Bottom of the page: highlight the last section (Contact is short)
    if (window.innerHeight + y >= document.documentElement.scrollHeight - 4) {
      return setActive(sections[sections.length - 1]?.id ?? "top");
    }

    const probe = y + window.innerHeight * 0.4;
    let current = "top";
    for (const sec of sections) {
      if (sec.id !== "top" && sec.offsetTop <= probe) current = sec.id;
    }
    setActive(current);
  }

  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(update);
  }

  update();
  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", onScroll);
</script>
