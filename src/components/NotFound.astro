---
// 404 page shared by "/404" (English) and "/es/404" (Spanish).
import Layout from "../layouts/Layout.astro";
import ArrowRightIcon from "./icons/ArrowRight.astro";
import { getLang, homePath, useTranslations } from "../i18n/ui";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<Layout title={t("notFound.title")} description={t("notFound.description")} noindex>
  {/* Hosts serve the root 404 for every missing URL: show the Spanish one when that is the visitor's language */}
  {
    lang === "en" && (
      <script is:inline slot="head">
        try {
          if (localStorage.getItem("lang") === "es" || location.pathname.startsWith("/es/")) {
            location.replace("/es/404/");
          }
        } catch {}
      </script>
    )
  }
  <main id="main" class="grid flex-1 place-items-center px-4 py-24 text-center">
    <div>
      <p
        class="bg-gradient-to-b from-white to-violet-400 bg-clip-text text-8xl font-bold tracking-tight text-transparent md:text-9xl"
      >
        404
      </p>
      <h1 class="mt-4 text-2xl font-semibold text-white">{t("notFound.heading")}</h1>
      <p class="mt-2 text-white/70">{t("notFound.text")}</p>
      <a
        href={homePath(lang)}
        class="group mt-8 inline-flex items-center gap-2 rounded-full bg-violet-600 px-5 py-2.5 font-medium text-white shadow-lg shadow-violet-900/40 transition hover:-translate-y-0.5 hover:bg-violet-500"
      >
        {t("notFound.back")}
        <ArrowRightIcon class="size-4 transition-transform group-hover:translate-x-0.5" />
      </a>
    </div>
  </main>
</Layout>
