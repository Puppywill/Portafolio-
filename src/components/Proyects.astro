---
import Xampp from "./icons/Xampp.astro";
import Visualstudio from "./icons/Visualstudio.astro";
import GithubIcon from "../components/icons/Github.astro";
import SocialPill from "../components/SocialPill.astro";
import BoostrapIcon from "../components/icons/Boostrap.astro";
import Astra from "../components/icons/Asap.astro";
import SqlIcon from "../components/icons/Sql.astro";
import CodeIcon from "../components/icons/Code.astro";
import "/src/animacionimg/animacionimg.css";

const TAGS = {
  Html: {
    name: "HTML",
    class: "bg-orange-500/15 text-orange-200 ring-1 ring-orange-400/30",
    icon: CodeIcon,
  },
  Css: {
    name: "CSS",
    class: "bg-sky-500/15 text-sky-200 ring-1 ring-sky-400/30",
    icon: CodeIcon,
  },
  JavaScript: {
    name: "JavaScript",
    class: "bg-yellow-400/15 text-yellow-100 ring-1 ring-yellow-300/30",
    icon: CodeIcon,
  },
  Node: {
    name: "Node.js",
    class: "bg-emerald-500/15 text-emerald-200 ring-1 ring-emerald-400/30",
    icon: CodeIcon,
  },
  Express: {
    name: "Express",
    class: "bg-zinc-500/20 text-zinc-100 ring-1 ring-zinc-300/20",
    icon: CodeIcon,
  },
  Xampp: {
    name: "Xampp",
    class: "bg-black text-white",
    icon: Xampp,
  },
  Visualstudio: {
    name: "Visual Basic",
    class: "bg-[#003159] text-white",
    icon: Visualstudio,
  },
  Boostrap: {
    name: "Boostrap",
    class: "bg-white text-black",
    icon: BoostrapIcon,
  },
  Astra: {
    name: "ASP.net",
    class: "bg-[#6601AF] text-white",
    icon: Astra,
  },
  Sql: {
    name: "SQL Server",
    class: "bg-cyan-500/15 text-cyan-100 ring-1 ring-cyan-300/30",
    icon: SqlIcon,
  },
};

const PROJECTS = [
  {
    title: "Help Desk Ticket System",
    description:
      "A professional IT Support ticket management system with authentication, role-based access, SQL Server integration, user administration, notifications, forgot password workflow, and PDF/Excel reporting with real support data.",
    github: "https://github.com/Puppywill/helpdesk-ticket-system",
    image: "/screenshots/admin-dashboard.png",
    tags: [TAGS.Html, TAGS.Css, TAGS.JavaScript, TAGS.Node, TAGS.Express, TAGS.Sql],
    featured: true,
  },
  {
    title: "VentaGaming",
    description:
      "A desktop database project for managing customers and sales records for a gaming products company, including Excel export functionality using Visual Basic, MySQL, and XAMPP.",
    github: "https://github.com/Puppywill/Ventagaming",
    image: "/proyects/venta.webp",
    tags: [TAGS.Xampp, TAGS.Visualstudio],
  },
  {
    title: "Chill's Restaurant",
    description:
      "A collaborative restaurant website built with ASP.NET and Microsoft SQL Server, focused on presenting a dynamic web experience backed by database-driven content.",
    github: "https://github.com/Puppywill/ChillsRestaurant",
    image: "/proyects/Chills.webp",
    tags: [TAGS.Boostrap, TAGS.Astra, TAGS.Sql],
  },
];
---

<div class="grid gap-8">
  {PROJECTS.map(({ image, title, description, tags, github, featured }) => (
    <article
      class={`group relative overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03] p-4 shadow-2xl shadow-black/20 transition duration-300 hover:-translate-y-1 hover:border-cyan-300/35 hover:bg-white/[0.055] md:p-6 ${
        featured ? "ring-1 ring-cyan-300/25" : ""
      }`}
    >
      <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top_right,rgba(34,211,238,0.14),transparent_36%)] opacity-0 transition duration-300 group-hover:opacity-100"></div>

      <div class="grid gap-6 lg:grid-cols-[1.05fr_1.4fr] lg:items-center">
        <div class="space-y-4">
          {featured && (
            <span class="inline-flex w-fit rounded-full border border-cyan-300/30 bg-cyan-400/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-cyan-100">
              Featured Project
            </span>
          )}

          <h3 class="text-2xl font-semibold text-white md:text-3xl">{title}</h3>
          <p class="text-pretty text-base leading-7 text-white/78 md:text-lg">{description}</p>

          <ul class="flex flex-wrap gap-2">
            {tags.map((tag) => (
              <li>
                <span class={`inline-flex items-center gap-x-2 rounded-full px-3 py-1.5 text-xs font-semibold ${tag.class}`}>
                  <tag.icon class="size-4" />
                  {tag.name}
                </span>
              </li>
            ))}
          </ul>

          <div class="pt-1">
            <SocialPill href={github}>
              <GithubIcon class="size-4 lg:size-6" />
              GitHub
            </SocialPill>
          </div>
        </div>

        <div class="relative w-full overflow-hidden rounded-xl border border-white/10 bg-black/20 shadow-2xl shadow-cyan-950/20 aspect-[16/9]">
          <img
            src={image}
            alt={`Screenshot of the project ${title}`}
            loading="lazy"
            decoding="async"
            fetchpriority="low"
            sizes="(min-width: 1024px) 760px, 100vw"
            class="imagen-animada absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-[1.02]"
          />
        </div>
      </div>
    </article>
  ))}
</div>
