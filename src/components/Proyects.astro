---
import Xampp from "./icons/Xampp.astro";
import Visualstudio from "./icons/Visualstudio.astro";
import GithubIcon from "./icons/Github.astro";
import BootstrapIcon from "./icons/Boostrap.astro";
import AspNetIcon from "./icons/Asap.astro";
import HtmlIcon from "./icons/Html.astro";
import CssIcon from "./icons/Css.astro";
import JavaScriptIcon from "./icons/JavaScript.astro";
import NodeJsIcon from "./icons/NodeJs.astro";
import ExpressIcon from "./icons/Express.astro";
import SqlServerIcon from "./icons/SqlServer.astro";
import DatabaseIcon from "./icons/Sql.astro";
import PythonIcon from "./icons/Python.astro";
import QtIcon from "./icons/Qt.astro";
import FfmpegIcon from "./icons/Ffmpeg.astro";
import OpenCvIcon from "./icons/OpenCv.astro";
import NumpyIcon from "./icons/Numpy.astro";
import NvidiaIcon from "./icons/Nvidia.astro";
import WindowsIcon from "./icons/Windows.astro";
import ExternalLinkIcon from "./icons/ExternalLink.astro";
import MaximizeIcon from "./icons/Maximize.astro";
import CloseIcon from "./icons/Close.astro";
import CheckIcon from "./icons/Check.astro";
import StarIcon from "./icons/Star.astro";
import SocialPill from "./SocialPill.astro";
import { getLang, useTranslations, type Localized } from "../i18n/ui";

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const TAGS = {
  Html: { name: "HTML", class: "bg-orange-500/15 text-orange-200 ring-orange-400/30", icon: HtmlIcon },
  Css: { name: "CSS", class: "bg-sky-500/15 text-sky-200 ring-sky-400/30", icon: CssIcon },
  JavaScript: { name: "JavaScript", class: "bg-yellow-400/15 text-yellow-100 ring-yellow-300/30", icon: JavaScriptIcon },
  Node: { name: "Node.js", class: "bg-emerald-500/15 text-emerald-200 ring-emerald-400/30", icon: NodeJsIcon },
  Express: { name: "Express", class: "bg-zinc-500/20 text-zinc-100 ring-zinc-300/20", icon: ExpressIcon },
  Xampp: { name: "XAMPP", class: "bg-orange-600/15 text-orange-100 ring-orange-400/25", icon: Xampp },
  VisualBasic: { name: "Visual Basic", class: "bg-blue-600/20 text-blue-100 ring-blue-400/30", icon: Visualstudio },
  MySql: { name: "MySQL", class: "bg-teal-500/15 text-teal-100 ring-teal-300/30", icon: DatabaseIcon },
  Bootstrap: { name: "Bootstrap", class: "bg-violet-500/15 text-violet-100 ring-violet-300/30", icon: BootstrapIcon },
  AspNet: { name: "ASP.NET", class: "bg-purple-600/20 text-purple-100 ring-purple-400/30", icon: AspNetIcon },
  Sql: { name: "SQL Server", class: "bg-cyan-500/15 text-cyan-100 ring-cyan-300/30", icon: SqlServerIcon },
  Python: { name: "Python", class: "bg-blue-500/15 text-blue-100 ring-blue-300/30", icon: PythonIcon },
  PySide: { name: "PySide6", class: "bg-emerald-500/15 text-emerald-100 ring-emerald-300/30", icon: QtIcon },
  FFmpeg: { name: "FFmpeg", class: "bg-lime-500/15 text-lime-100 ring-lime-300/30", icon: FfmpegIcon },
  OpenCV: { name: "OpenCV", class: "bg-red-500/15 text-red-100 ring-red-300/30", icon: OpenCvIcon },
  NumPy: { name: "NumPy", class: "bg-sky-500/15 text-sky-100 ring-sky-300/30", icon: NumpyIcon },
  Nvenc: { name: "NVIDIA NVENC", class: "bg-green-500/15 text-green-100 ring-green-300/30", icon: NvidiaIcon },
};

type Tag = (typeof TAGS)[keyof typeof TAGS];

interface Project {
  title: string;
  category: Localized;
  description: Localized;
  github: string;
  /** Optional live demo URL — a "Live Demo" button appears when set */
  demo?: string;
  /** Optional download URL (e.g. GitHub Releases) */
  download?: string;
  image: string;
  width: number;
  height: number;
  tags: Tag[];
  features?: Localized<string[]>;
  featured?: boolean;
  /** Optional project status badge (e.g. not yet deployed) */
  status?: Localized;
  /** Use "View on GitHub" instead of "View Code" for the repository button */
  githubLabel?: "viewOnGithub";
}

const PROJECTS: Project[] = [
  {
    title: "Puppywill AI Clipper",
    category: {
      en: "Windows Desktop App · Video Analysis",
      es: "App de escritorio para Windows · Análisis de video",
    },
    description: {
      en: "A Windows desktop application that analyzes long gaming and IRL stream recordings to automatically detect and rank highlight moments. It combines audio intensity, reactions, visual movement, and scene changes, then exports clean clips in vertical, horizontal, or square formats.",
      es: "Una aplicación de escritorio para Windows que analiza grabaciones largas de streams de gaming e IRL para detectar y clasificar automáticamente los mejores momentos. Combina la intensidad del audio, las reacciones, el movimiento visual y los cambios de escena, y luego exporta clips limpios en formato vertical, horizontal o cuadrado.",
    },
    github: "https://github.com/Puppywill/Puppywill-AI-Clipper",
    download: "https://github.com/Puppywill/Puppywill-AI-Clipper/releases/latest",
    image: "/screenshots/puppywill-ai-clipper-app.webp",
    width: 1216,
    height: 1012,
    tags: [TAGS.Python, TAGS.PySide, TAGS.FFmpeg, TAGS.OpenCV, TAGS.NumPy, TAGS.Nvenc],
    features: {
      en: [
        "Ranks every moment with a 0–100 quality score and labels like Kill, Multikill, Best Play, and Reaction",
        "GPU-accelerated decoding and export (NVDEC / NVENC) with automatic CPU fallback",
        "Audio and video analyzed in parallel, with real progress, ETA, and cancel at any time",
        "Preview and fine-tune each clip, then batch-export to 9:16, 16:9, and 1:1",
        "Result caching and project save/load to resume work later",
        "Windows installer with FFmpeg bundled · UI in English, Spanish, and Portuguese",
      ],
      es: [
        "Clasifica cada momento con una puntuación de calidad de 0 a 100 y etiquetas como Kill, Multikill, Best Play y Reaction",
        "Decodificación y exportación aceleradas por GPU (NVDEC / NVENC) con respaldo automático a CPU",
        "Audio y video analizados en paralelo, con progreso real, tiempo estimado y opción de cancelar en cualquier momento",
        "Vista previa y ajuste de cada clip, con exportación por lotes en 9:16, 16:9 y 1:1",
        "Caché de resultados y guardar/cargar proyectos para retomar el trabajo después",
        "Instalador para Windows con FFmpeg incluido · Interfaz en inglés, español y portugués",
      ],
    },
    featured: true,
  },
  {
    title: "Service Billing System",
    category: {
      en: "Internal Web Application · SQL Server",
      es: "Aplicación web interna · SQL Server",
    },
    status: {
      en: "Pending Production Deployment",
      es: "Pendiente de despliegue en producción",
    },
    description: {
      en: "A web-based service billing application developed as an alternative to an Access-based billing process. It allows technicians to record service hours by client and project while administrators manage billing, generate invoices, and produce service-hour reports.",
      es: "Una aplicación web de facturación de servicios desarrollada como alternativa a un proceso de facturación basado en Access. Permite a los técnicos registrar horas de servicio por cliente y proyecto, mientras los administradores gestionan la facturación, generan facturas y preparan reportes de horas de servicio.",
    },
    github: "https://github.com/Puppywill/Service-Billing-System",
    githubLabel: "viewOnGithub",
    image: "/screenshots/service-billing-system-dashboard.webp",
    width: 1600,
    height: 900,
    tags: [TAGS.Html, TAGS.Css, TAGS.JavaScript, TAGS.Node, TAGS.Express, TAGS.Sql],
    features: {
      en: [
        "Service-hour tracking by client and project",
        "Manual PDF invoices with optional 11.5% IVU",
        "Reports by technician, client, and project with billed and unbilled hours, exported to PDF and Excel",
        "Role-based access (Admin, Project Manager, Technician) with authentication and administrative controls",
      ],
      es: [
        "Registro de horas de servicio por cliente y proyecto",
        "Facturas manuales en PDF con IVU opcional de 11.5%",
        "Reportes por técnico, cliente y proyecto con horas facturadas y no facturadas, exportables a PDF y Excel",
        "Acceso por roles (Admin, Project Manager, Technician) con autenticación y controles administrativos",
      ],
    },
    featured: true,
  },
  {
    title: "Help Desk Ticket System",
    category: { en: "Full-Stack Web App", es: "App web full-stack" },
    description: {
      en: "A professional IT Support ticket management system with authentication, role-based access, SQL Server integration, user administration, notifications, forgot password workflow, and PDF/Excel reporting with real support data.",
      es: "Un sistema profesional de gestión de tickets de soporte IT con autenticación, acceso basado en roles, integración con SQL Server, administración de usuarios, notificaciones, recuperación de contraseña y reportes en PDF/Excel con datos reales de soporte.",
    },
    github: "https://github.com/Puppywill/helpdesk-ticket-system",
    image: "/screenshots/admin-dashboard.webp",
    width: 1280,
    height: 971,
    tags: [TAGS.Html, TAGS.Css, TAGS.JavaScript, TAGS.Node, TAGS.Express, TAGS.Sql],
  },
  {
    title: "VentaGaming",
    category: { en: "Desktop App · Database", es: "App de escritorio · Base de datos" },
    description: {
      en: "A desktop database project for managing customers and sales records for a gaming products company, including Excel export functionality using Visual Basic, MySQL, and XAMPP.",
      es: "Un proyecto de escritorio con base de datos para gestionar clientes y registros de ventas de una empresa de productos de gaming, con exportación a Excel, usando Visual Basic, MySQL y XAMPP.",
    },
    github: "https://github.com/Puppywill/Ventagaming",
    image: "/proyects/venta.webp",
    width: 960,
    height: 720,
    tags: [TAGS.VisualBasic, TAGS.MySql, TAGS.Xampp],
  },
  {
    title: "Chill's Restaurant",
    category: { en: "Web App · Team Project", es: "App web · Proyecto en equipo" },
    description: {
      en: "A collaborative restaurant website built with ASP.NET and Microsoft SQL Server, focused on presenting a dynamic web experience backed by database-driven content.",
      es: "Un sitio web colaborativo para un restaurante, construido con ASP.NET y Microsoft SQL Server, enfocado en ofrecer una experiencia web dinámica con contenido basado en bases de datos.",
    },
    github: "https://github.com/Puppywill/ChillsRestaurant",
    image: "/proyects/Chills.webp",
    width: 960,
    height: 720,
    tags: [TAGS.Bootstrap, TAGS.AspNet, TAGS.Sql],
  },
];

const featured = PROJECTS.filter((p) => p.featured);
const others = PROJECTS.filter((p) => !p.featured);
---

<div class="grid gap-8">
  {
    featured.map((project) => (
      <article
        data-reveal
        class="group relative overflow-hidden rounded-3xl border border-violet-400/30 bg-gradient-to-b from-violet-500/[0.09] to-white/[0.02] p-4 shadow-2xl shadow-violet-950/30 md:p-6"
      >
        <div
          aria-hidden="true"
          class="pointer-events-none absolute -right-24 -top-24 size-72 rounded-full bg-violet-500/20 blur-3xl"
        />

        <button
          type="button"
          data-lightbox={project.image}
          data-alt={`${t("a11y.screenshotOf")} ${project.title}`}
          aria-label={`${t("a11y.enlargeScreenshot")} ${project.title}`}
          class="relative block w-full cursor-zoom-in overflow-hidden rounded-2xl border border-white/10 bg-black/30 shadow-xl shadow-black/40"
        >
          <img
            src={project.image}
            alt={`${t("a11y.screenshotOf")} ${project.title}`}
            width={project.width}
            height={project.height}
            loading="lazy"
            decoding="async"
            class="h-auto w-full transition duration-500 group-hover:scale-[1.015]"
          />
          <span class="absolute bottom-3 right-3 inline-flex items-center gap-1.5 rounded-full bg-black/70 px-3 py-1 text-xs text-white/90 backdrop-blur transition md:opacity-0 md:group-hover:opacity-100">
            <MaximizeIcon class="size-3.5" /> {t("projects.viewFullSize")}
          </span>
        </button>

        <div class="relative mt-6 md:mt-8">
          <div class="flex flex-wrap items-center gap-2">
            <span class="inline-flex items-center gap-1.5 rounded-full border border-violet-300/40 bg-violet-500/15 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-violet-100">
              <StarIcon class="size-3.5" /> {t("projects.featured")}
            </span>
            {project.status && (
              <span class="inline-flex items-center gap-1.5 rounded-full border border-amber-300/30 bg-amber-400/10 px-3 py-1 text-xs font-semibold text-amber-100">
                <span aria-hidden="true" class="size-1.5 rounded-full bg-amber-300" />
                {project.status[lang]}
              </span>
            )}
            <span class="text-sm text-white/60">{project.category[lang]}</span>
          </div>

          <h3 class="mt-3 bg-gradient-to-r from-white via-white to-violet-200 bg-clip-text text-3xl font-bold text-transparent md:text-4xl">
            {project.title}
          </h3>
          <p class="mt-3 text-pretty text-base leading-7 text-white/80 md:text-lg">{project.description[lang]}</p>

          {project.features && (
            <ul class="mt-6 grid gap-3 md:grid-cols-2" aria-label={t("a11y.keyFeatures")}>
              {project.features[lang].map((feature) => (
                <li class="flex gap-x-3 rounded-xl border border-white/10 bg-black/20 p-3 text-sm leading-6 text-white/80">
                  <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-violet-500/20 text-violet-300">
                    <CheckIcon class="size-3.5" />
                  </span>
                  {feature}
                </li>
              ))}
            </ul>
          )}

          <ul class="mt-6 flex flex-wrap gap-2" aria-label={t("a11y.technologies")}>
            {project.tags.map((tag) => (
              <li class={`inline-flex items-center gap-x-2 rounded-full px-3 py-1.5 text-xs font-semibold ring-1 ${tag.class}`}>
                <tag.icon class="size-4" />
                {tag.name}
              </li>
            ))}
          </ul>

          <div class="mt-6 flex flex-wrap gap-3">
            {project.download && (
              <SocialPill href={project.download} variant="primary">
                <WindowsIcon class="size-4 md:size-5" />
                {t("projects.download")}
              </SocialPill>
            )}
            <SocialPill href={project.github}>
              <GithubIcon class="size-4 md:size-5" />
              {project.githubLabel === "viewOnGithub" ? t("projects.viewOnGithub") : t("projects.viewCode")}
            </SocialPill>
            {project.demo && (
              <SocialPill href={project.demo}>
                <ExternalLinkIcon class="size-4 md:size-5" />
                {t("projects.liveDemo")}
              </SocialPill>
            )}
          </div>
        </div>
      </article>
    ))
  }

  {
    others.map((project) => (
      <article
        data-reveal
        class="group grid gap-5 rounded-2xl border border-white/10 bg-white/[0.03] p-4 shadow-xl shadow-black/20 transition duration-300 hover:-translate-y-1 hover:border-violet-400/40 hover:bg-white/[0.05] md:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] md:items-center md:gap-6 md:p-5"
      >
        <button
          type="button"
          data-lightbox={project.image}
          data-alt={`${t("a11y.screenshotOf")} ${project.title}`}
          aria-label={`${t("a11y.enlargeScreenshot")} ${project.title}`}
          class="relative block aspect-[4/3] w-full cursor-zoom-in overflow-hidden rounded-xl border border-white/10 bg-black/30"
        >
          <img
            src={project.image}
            alt={`${t("a11y.screenshotOf")} ${project.title}`}
            width={project.width}
            height={project.height}
            loading="lazy"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover object-top transition duration-500 group-hover:scale-[1.04]"
          />
        </button>

        <div>
          <p class="text-xs font-medium uppercase tracking-wider text-violet-300/90">{project.category[lang]}</p>
          <h3 class="mt-1.5 text-2xl font-semibold text-white">{project.title}</h3>
          <p class="mt-2 text-pretty text-[15px] leading-7 text-white/75">{project.description[lang]}</p>

          <ul class="mt-4 flex flex-wrap gap-2" aria-label={t("a11y.technologies")}>
            {project.tags.map((tag) => (
              <li class={`inline-flex items-center gap-x-1.5 rounded-full px-2.5 py-1 text-xs font-semibold ring-1 ${tag.class}`}>
                <tag.icon class="size-3.5" />
                {tag.name}
              </li>
            ))}
          </ul>

          <div class="mt-5 flex flex-wrap gap-3">
            <SocialPill href={project.github}>
              <GithubIcon class="size-4 md:size-5" />
              {t("projects.viewCode")}
            </SocialPill>
            {project.demo && (
              <SocialPill href={project.demo}>
                <ExternalLinkIcon class="size-4 md:size-5" />
                {t("projects.liveDemo")}
              </SocialPill>
            )}
          </div>
        </div>
      </article>
    ))
  }
</div>

<p class="mt-8 text-center text-sm text-white/60" data-reveal>
  {t("projects.moreOn")}
  <a
    href="https://github.com/Puppywill"
    target="_blank"
    rel="noopener noreferrer"
    class="inline-block py-2 font-medium text-violet-300 underline-offset-4 hover:text-violet-200 hover:underline">GitHub ↗</a
  >
</p>

<dialog
  id="lightbox"
  aria-label={t("a11y.projectScreenshot")}
  class="m-auto max-h-[92vh] w-[min(1200px,94vw)] overflow-visible bg-transparent p-0 backdrop:bg-black/80 backdrop:backdrop-blur-sm"
>
  <img id="lightbox-img" src="" alt="" class="max-h-[88vh] w-full rounded-xl border border-white/10 object-contain shadow-2xl" />
  <button
    type="button"
    id="lightbox-close"
    aria-label={t("a11y.close")}
    class="absolute right-2 top-2 grid size-11 place-items-center rounded-full border border-white/15 bg-zinc-900/90 text-white hover:bg-violet-600 sm:-right-3 sm:top-0 sm:size-10 sm:translate-x-full"
  >
    <CloseIcon class="size-5" />
  </button>
</dialog>

<script>
  const dialog = document.getElementById("lightbox") as HTMLDialogElement | null;
  const img = document.getElementById("lightbox-img") as HTMLImageElement | null;

  if (dialog && img && typeof dialog.showModal === "function") {
    document.querySelectorAll<HTMLButtonElement>("[data-lightbox]").forEach((trigger) => {
      trigger.addEventListener("click", () => {
        img.src = trigger.dataset.lightbox ?? "";
        img.alt = trigger.dataset.alt ?? "";
        dialog.showModal();
      });
    });

    document.getElementById("lightbox-close")?.addEventListener("click", () => dialog.close());
    // Close when clicking the backdrop (outside the image)
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>
