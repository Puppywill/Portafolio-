---
// Every item here is backed by the experience or projects shown on this page.
const GROUPS = [
  {
    title: "Programming Languages",
    items: ["Java", "JavaScript", "Python", "PHP", "SQL", "Visual Basic / VB.NET"],
  },
  {
    title: "Front-End",
    items: ["HTML", "CSS", "Astro", "Tailwind CSS", "Bootstrap", "WordPress / Elementor"],
  },
  {
    title: "Back-End",
    items: ["Node.js", "Express", "ASP.NET", "Flask (basic)"],
  },
  {
    title: "Databases",
    items: ["Microsoft SQL Server", "MySQL"],
  },
  {
    title: "Desktop & Media",
    items: ["PySide6 / Qt", "FFmpeg", "OpenCV", "NumPy"],
  },
  {
    title: "Tools",
    items: ["Git", "GitHub", "Postman", "Linux", "XAMPP", "Netlify"],
  },
  {
    title: "IT Support & Networking",
    items: [
      "Troubleshooting HW/SW/Network",
      "Windows OS Support",
      "LAN/WAN Fundamentals",
      "Router & Modem Setup (basic)",
      "Hardware Installation",
      "Ticketing",
      "Documentation",
      "SQL Backups",
      "QA",
      "Bilingual Customer Service (EN/ES)",
    ],
    wide: true,
  },
];
---

<div class="grid gap-4 sm:grid-cols-2">
  {
    GROUPS.map((group, i) => (
      <article
        data-reveal
        style={`--reveal-delay:${(i % 2) * 80}ms`}
        class:list={[
          "rounded-2xl border border-white/10 bg-white/[0.03] p-5 transition duration-300 hover:border-violet-400/40 hover:bg-white/[0.05]",
          group.wide && "sm:col-span-2",
        ]}
      >
        <h3 class="mb-3 text-sm font-semibold uppercase tracking-wider text-violet-300">{group.title}</h3>
        <ul class="flex flex-wrap gap-2">
          {group.items.map((item) => (
            <li class="rounded-lg border border-white/10 bg-white/5 px-2.5 py-1 text-sm text-white/85 transition hover:border-violet-400/40 hover:text-white">
              {item}
            </li>
          ))}
        </ul>
      </article>
    ))
  }
</div>
