---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  variant?: "default" | "primary";
  size?: "md" | "lg";
}

const { variant = "default", size = "md", class: className, href, ...rest } = Astro.props;

// Only external web links open in a new tab (mailto:, tel: and #anchors stay in place)
const isExternal = typeof href === "string" && /^https?:\/\//.test(href);
---

<a
  href={href}
  {...isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {}}
  {...rest}
  class:list={[
    "inline-flex items-center justify-center gap-x-2 rounded-full border font-medium transition duration-200 hover:-translate-y-0.5 active:translate-y-0",
    size === "lg" ? "px-5 py-2.5 text-base" : "px-3 py-1.5 text-sm md:px-4 md:py-2",
    variant === "primary"
      ? "border-violet-400/40 bg-violet-600 text-white shadow-lg shadow-violet-900/30 hover:bg-violet-500"
      : "border-white/10 bg-white/5 text-white hover:border-violet-400/40 hover:bg-white/10",
    className,
  ]}
>
  <slot />
</a>
