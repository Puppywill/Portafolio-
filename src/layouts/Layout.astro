---
import "@fontsource-variable/onest";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BackToTop from "../components/BackToTop.astro";
import { getLang, homePath, languages, useTranslations } from "../i18n/ui";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { description, title, noindex = false } = Astro.props;

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og-image.png", Astro.site);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "William A. Rosado Pérez",
  jobTitle: "Software Developer & IT Support",
  worksFor: { "@type": "Organization", name: "Solutions by Design" },
  knowsLanguage: ["English", "Spanish"],
  url: Astro.site?.toString(),
  image: new URL("/proyects/profile-288.webp", Astro.site).toString(),
  email: "mailto:williamarosado@gmail.com",
  address: { "@type": "PostalAddress", addressLocality: "Bayamón", addressRegion: "Puerto Rico" },
  alumniOf: "Inter American University of Puerto Rico",
  sameAs: [
    "https://www.linkedin.com/in/william-a-rosado-p%C3%A9rez",
    "https://github.com/Puppywill",
  ],
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="William A. Rosado Pérez" />
    <meta name="theme-color" content="#18181f" />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {
      !noindex &&
        Object.keys(languages).map((code) => (
          <link rel="alternate" hreflang={code} href={new URL(homePath(getLang(code)), Astro.site)} />
        ))
    }
    {!noindex && <link rel="alternate" hreflang="x-default" href={new URL("/", Astro.site)} />}

    <!-- Visitors who picked Spanish land on /es/ before the page paints -->
    <script is:inline>
      try {
        if (localStorage.getItem("lang") === "es" && (location.pathname === "/" || location.pathname === "/index.html")) {
          location.replace("/es/" + location.search + location.hash);
        }
      } catch {}
    </script>
    <slot name="head" />

    <!-- Profile photo is the LCP element of the hero -->
    <link rel="preload" as="image" href="/proyects/profile-288.webp" fetchpriority="high" />

    <!-- Icons -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="William A. Rosado Pérez" />
    <meta property="og:locale" content={t("meta.ogLocale")} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t("meta.ogImageAlt")} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="generator" content={Astro.generator} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <!-- Lets CSS know JS is available, so reveal animations never hide content without JS -->
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>

  <body class="font-sans text-zinc-100 antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[100] focus:rounded-md focus:bg-violet-600 focus:px-3 focus:py-2 focus:text-white"
    >
      {t("a11y.skip")}
    </a>
    <Header />
    <slot />
    <Footer />
    <BackToTop />
  </body>

  <style is:global>
    :root {
      color-scheme: dark;
    }

    body {
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      background: linear-gradient(180deg, #2b2c30 0%, #1e1f29 50%, #141518 100%);
      background-attachment: fixed;
    }

    /* Soft violet glow behind the hero */
    body::before {
      content: "";
      position: absolute;
      inset: 0 0 auto 0;
      height: 720px;
      background: radial-gradient(ellipse 60% 50% at 50% 0%, rgba(139, 92, 246, 0.16), transparent 70%);
      pointer-events: none;
      z-index: -1;
    }

    ::selection {
      background: rgba(139, 92, 246, 0.45);
      color: #fff;
    }

    :focus-visible {
      outline: 2px solid #a78bfa;
      outline-offset: 3px;
    }

    section[id] {
      scroll-margin-top: 96px;
    }

    /* Scroll reveal (only when JS is available) */
    .js [data-reveal] {
      opacity: 0;
      transform: translateY(18px);
      transition:
        opacity 0.6s ease,
        transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
      transition-delay: var(--reveal-delay, 0ms);
    }

    .js [data-reveal].is-visible {
      opacity: 1;
      transform: none;
    }

    @media (prefers-reduced-motion: reduce) {
      html {
        scroll-behavior: auto;
      }

      *,
      *::before,
      *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }

      .js [data-reveal] {
        opacity: 1;
        transform: none;
      }
    }
  </style>

  <script>
    const items = document.querySelectorAll<HTMLElement>("[data-reveal]");

    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        },
        { rootMargin: "0px 0px -40px 0px", threshold: 0.05 }
      );
      items.forEach((el) => observer.observe(el));
    } else {
      items.forEach((el) => el.classList.add("is-visible"));
    }
  </script>
</html>
