---
import Layout from "../layouts/Layout.astro";
import LinkedInIcon from "../components/icons/Linked.astro";
import GithubIcon from "../components/icons/Github.astro";
import MailIcon from "../components/icons/Mail.astro";
import DownloadIcon from "../components/icons/Download.astro";
import Briefcase from "../components/icons/Briefcase.astro";
import CodeIcon from "../components/icons/Code.astro";
import SchoolIcon from "../components/icons/School.astro";
import ToolsIcon from "../components/icons/Tools.astro";
import MapPinIcon from "../components/icons/MapPin.astro";
import ArrowRightIcon from "../components/icons/ArrowRight.astro";

import SocialPill from "../components/SocialPill.astro";
import SectionContainer from "../components/SectionContainer.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Experience from "../components/Experience.astro";
import Proyects from "../components/Proyects.astro";
import EducationCards from "../components/EducationCards.astro";
import Skills from "../components/Skills.astro";
import Contact from "../components/Contact.astro";
import Badge from "../components/Badge.astro";
import { CONTACT } from "../data/contact";

const HIGHLIGHTS = [
  "B.S. Computer Science",
  "Google Cybersecurity Certificate",
  "Bilingual · English / Spanish",
];
---

<Layout
  title="William A. Rosado Pérez — Software Developer & IT Support"
  description="Software Developer and IT Support professional from Bayamón, Puerto Rico with a B.S. in Computer Science. Explore projects in Python, JavaScript, and SQL Server, including Puppywill AI Clipper."
>
  <main id="main" class="px-4">
    <SectionContainer id="top" class="pb-24 pt-20 md:pb-32 md:pt-32">
      <div class="hero-in">
        <div class="relative mb-6 w-fit">
          <div aria-hidden="true" class="absolute -inset-1.5 rounded-full bg-gradient-to-tr from-violet-600 via-fuchsia-400 to-indigo-500 opacity-70 blur-md"></div>
          <img
            src="/proyects/profile-288.webp"
            alt="William A. Rosado Pérez"
            width="128"
            height="128"
            loading="eager"
            decoding="async"
            fetchpriority="high"
            class="relative size-28 rounded-full border-2 border-white/20 object-cover md:size-32"
          />
        </div>

        <div class="mb-4 flex flex-wrap items-center gap-3">
          <a
            href={CONTACT.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Available to work — view my LinkedIn profile"
            class="rounded-full"
          >
            <Badge />
          </a>
          <span class="inline-flex items-center gap-1 text-sm text-white/60">
            <MapPinIcon class="size-4" /> Bayamón, Puerto Rico
          </span>
        </div>

        <h1 class="text-balance text-4xl font-bold tracking-tight text-white md:text-5xl">
          Hi, I'm William A. Rosado Pérez
        </h1>
        <p class="mt-3 bg-gradient-to-r from-violet-300 to-fuchsia-300 bg-clip-text text-xl font-semibold text-transparent md:text-2xl">
          Software Developer &amp; IT Support
        </p>

        <p class="mt-5 max-w-[680px] text-pretty text-lg leading-relaxed text-white/75 md:text-xl">
          I build desktop and web applications with Python, JavaScript, and SQL Server, and I currently provide help
          desk and database support at Solutions by Design. B.S. in Computer Science from the Inter American University
          of Puerto Rico (2020–2024).
        </p>

        <ul class="mt-6 flex flex-wrap gap-2" aria-label="Highlights">
          {
            HIGHLIGHTS.map((item) => (
              <li class="rounded-full border border-violet-400/20 bg-violet-500/10 px-3 py-1 text-sm text-violet-100/90">
                {item}
              </li>
            ))
          }
        </ul>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="#projects"
            class="group inline-flex items-center gap-2 rounded-full bg-violet-600 px-5 py-2.5 font-medium text-white shadow-lg shadow-violet-900/40 transition hover:-translate-y-0.5 hover:bg-violet-500"
          >
            View Projects
            <ArrowRightIcon class="size-4 transition-transform group-hover:translate-x-0.5" />
          </a>
          <SocialPill href={CONTACT.cv} size="lg">
            <DownloadIcon class="size-5" />
            Download CV
          </SocialPill>
        </div>

        <nav aria-label="Profiles" class="mt-5 flex flex-wrap gap-3">
          <SocialPill href={CONTACT.linkedin}>
            <LinkedInIcon class="size-4 md:size-5" />
            LinkedIn
          </SocialPill>
          <SocialPill href={CONTACT.github}>
            <GithubIcon class="size-4 md:size-5" />
            GitHub
          </SocialPill>
          <SocialPill href={`mailto:${CONTACT.email}`}>
            <MailIcon class="size-4 md:size-5" />
            Contact Me
          </SocialPill>
        </nav>
      </div>
    </SectionContainer>

    <SectionContainer id="experience" labelledby="experience-title">
      <SectionHeading id="experience-title" eyebrow="Career">
        <Briefcase slot="icon" />
        Experience
      </SectionHeading>
      <Experience />
    </SectionContainer>

    <SectionContainer id="projects" labelledby="projects-title">
      <SectionHeading
        id="projects-title"
        eyebrow="Portfolio"
        subtitle="Desktop, web, and database projects — from a GPU-accelerated video analysis app to a full-stack help desk system."
      >
        <CodeIcon slot="icon" />
        Projects
      </SectionHeading>
      <Proyects />
    </SectionContainer>

    <SectionContainer id="education" labelledby="education-title">
      <SectionHeading id="education-title" eyebrow="Background">
        <SchoolIcon slot="icon" />
        Education &amp; Certifications
      </SectionHeading>
      <EducationCards />
    </SectionContainer>

    <SectionContainer id="skills" labelledby="skills-title">
      <SectionHeading id="skills-title" eyebrow="Toolbox">
        <ToolsIcon slot="icon" />
        Skills &amp; Tools
      </SectionHeading>
      <Skills />
    </SectionContainer>

    <SectionContainer id="contact" labelledby="contact-title" class="md:pb-24">
      <Contact />
    </SectionContainer>
  </main>
</Layout>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .hero-in > * {
      animation: hero-in 0.7s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    .hero-in > *:nth-child(2) { animation-delay: 60ms; }
    .hero-in > *:nth-child(3) { animation-delay: 120ms; }
    .hero-in > *:nth-child(4) { animation-delay: 180ms; }
    .hero-in > *:nth-child(5) { animation-delay: 240ms; }
    .hero-in > *:nth-child(6) { animation-delay: 300ms; }
    .hero-in > *:nth-child(7) { animation-delay: 360ms; }
    .hero-in > *:nth-child(8) { animation-delay: 420ms; }
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
</style>
